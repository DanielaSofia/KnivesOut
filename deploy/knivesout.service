[Unit]
Description=Knivesout Next.js application
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=simple
User=danilobo
Group=danilobo
WorkingDirectory=/home/danilobo/ko/knivesout
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=PATH=/home/danilobo/.nvm/versions/node/v24.20.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=-/home/danilobo/ko/knivesout/.env
ExecStart=/home/danilobo/.nvm/versions/node/v24.20.0/bin/npm run start
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
